# Copy this file to `.env` and adjust values as needed.
# All variables are optional — defaults are defined in config.py.

# OPENFDA_BASE_URL=https://api.fda.gov/drug/event.json
# OPENFDA_DATA_START_DATE=20200101
# OPENFDA_REQUEST_TIMEOUT=30

# LSTM_MODEL_PATH=models/lstm_model.keras
# SCALER_PATH=models/scaler.pkl
# LSTM_LOOKBACK=24
# LSTM_EPOCHS=15
# LSTM_BATCH_SIZE=16

# OLLAMA_MODEL=mistral
# OLLAMA_TEMPERATURE=0.0

# --- LangSmith Tracing ---
# Set to 'true' and add your API key to trace LangGraph agent reasoning
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_api_key_here
# LANGCHAIN_PROJECT=medical_ai_analyst
